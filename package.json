{
    "name": "dataview-serializer",
    "version": "3.1.2",
    "description": "Obsidian plugin that gives you the power of Dataview, but generates Markdown, making it compatible with Obsidian Publish, and making the links appear on the Graph",
    "author": {
        "name": "Sebastien Dubois",
        "email": "sebastien@developassion.be"
    },
    "keywords": [
        "obsidian",
        "obsidian-plugin",
        "dataview",
        "serialization",
        "markdown"
    ],
    "license": "MIT",
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dsebastien/obsidian-dataview-serializer.git"
    },
    "bugs": {
        "url": "https://github.com/dsebastien/obsidian-dataview-serializer/issues"
    },
    "homepage": "https://github.com/dsebastien/obsidian-dataview-serializer",
    "engines": {
        "bun": ">=1.0.0"
    },
    "main": "main.js",
    "packageManager": "bun@1.4.0",
    "config": {
        "commitizen": {
            "path": "node_modules/cz-customizable"
        },
        "cz-customizable": {
            "config": ".cz-config.cjs"
        }
    },
    "scripts": {
        "dev": "bun scripts/build.ts",
        "build": "bun run tsc && bun scripts/build.ts --prod",
        "setup": "git config --local --replace-all include.path ../.gitconfig",
        "tsc": "tsc --noEmit",
        "tsc:watch": "tsc --noEmit --watch --preserveWatchOutput",
        "tscw": "bun run tsc:watch",
        "lint": "node scripts/require-node.mjs && eslint . --max-warnings 0",
        "lint:fix": "node scripts/require-node.mjs && eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "bun test --isolate",
        "test:watch": "bun test --isolate --watch",
        "commit": "cz",
        "cm": "cz",
        "commit:lint": "commitlint --edit",
        "release:update-version": "bun scripts/update-version.ts",
        "release:version-bump": "bun scripts/version-bump.ts",
        "release:changelog": "bun scripts/generate-changelog.ts",
        "release": "./scripts/release.sh",
        "validate": "bun run --parallel tsc test lint rules:check",
        "rules:check": "bun scripts/rules-baseline.ts",
        "rules:baseline": "bun scripts/rules-baseline.ts --write"
    },
    "devDependencies": {
        "@codemirror/state": "^6.7.5",
        "@codemirror/view": "^6.43.12",
        "@commitlint/cli": "^20.5.3",
        "@commitlint/config-conventional": "^20.5.3",
        "@eslint/js": "^9.36.0",
        "@tailwindcss/cli": "4.3.3",
        "@types/bun": "1.4.2",
        "@types/luxon": "3.7.5",
        "@types/node": "24.10.1",
        "commitizen": "^4.3.2",
        "conventional-changelog-cli": "5.0.0",
        "conventional-changelog-conventionalcommits": "9.1.0",
        "cz-customizable": "^7.5.4",
        "eslint": "^9.36.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-obsidianmd": "0.4.2",
        "globals": "17.12.0",
        "jiti": "2.7.0",
        "obsidian": "1.13.1",
        "obsidian-dataview": "0.5.68",
        "prettier": "^3.9.8",
        "tailwindcss": "4.3.3",
        "typescript": "^5.9.3",
        "typescript-eslint": "8.70.0"
    },
    "dependencies": {
        "date-fns": "^3.6.0",
        "immer": "11.0.1"
    },
    "overrides": {
        "svelte": "^4.2.19",
        "@conventional-changelog/git-client": "2.7.0",
        "handlebars": "4.7.9",
        "lodash": "4.18.1",
        "fast-uri": "3.1.6",
        "flatted": "3.4.2",
        "yaml": "2.9.0",
        "js-yaml": "4.3.2",
        "tmp": "0.2.7",
        "brace-expansion": "2.1.4",
        "minimatch": "3.1.5",
        "picomatch": "2.3.2"
    }
}
